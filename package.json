{
  "name": "@arraypress/waveform-bar",
  "version": "1.12.2",
  "description": "Persistent bottom audio player bar for WaveformPlayer - queue management, page persistence, and seamless playback.",
  "main": "dist/waveform-bar.js",
  "module": "dist/waveform-bar.esm.js",
  "unpkg": "dist/waveform-bar.min.js",
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "npm run build:iife && npm run build:esm && npm run build:min",
    "build:css": "cp src/css/waveform-bar.css dist/ && esbuild src/css/waveform-bar.css --minify --outfile=dist/waveform-bar.min.css && cp src/css/waveform-bar-icons.css dist/ && rm -rf dist/icons && cp -r src/icons dist/icons",
    "build:iife": "esbuild src/js/index.js --bundle --format=iife --outfile=dist/waveform-bar.js",
    "build:esm": "esbuild src/js/index.js --bundle --format=esm --outfile=dist/waveform-bar.esm.js",
    "build:min": "esbuild src/js/index.js --bundle --format=iife --minify --outfile=dist/waveform-bar.min.js",
    "dev": "esbuild src/js/index.js --bundle --format=iife --outfile=dist/waveform-bar.js --watch",
    "serve": "npx http-server -p 8000",
    "size": "npm run build && echo 'JS:' && gzip -c dist/waveform-bar.min.js | wc -c && echo 'CSS:' && gzip -c dist/waveform-bar.min.css | wc -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "audio",
    "player",
    "persistent",
    "bottom-bar",
    "waveform",
    "queue",
    "music",
    "podcast",
    "beat-store",
    "sample-library",
    "shopify",
    "wordpress"
  ],
  "author": "ArrayPress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaveformPlayer/waveform-bar.git"
  },
  "bugs": {
    "url": "https://github.com/WaveformPlayer/waveform-bar/issues"
  },
  "homepage": "https://github.com/WaveformPlayer/waveform-bar#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@arraypress/waveform-player": "^1.8.0"
  },
  "devDependencies": {
    "@arraypress/waveform-player": "^1.30.2",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
