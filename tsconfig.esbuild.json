// The bundler's view of TypeScript, kept apart from tsconfig.json on purpose.
// esbuild honours tsconfig.json's `strict` (alwaysStrict) by putting
// "use strict" at the top of the IIFE bundles, which 1.x never shipped: sloppy
// and strict mode differ at runtime. TypeScript 7 removed `alwaysStrict: false`,
// so the build points esbuild here instead (--tsconfig). Only the options that
// change emitted code are listed; type checking uses tsconfig.json.
{
  "compilerOptions": {
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true
  }
}
